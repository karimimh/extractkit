# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DB=distillpage
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Google OAuth ───────────────────────────────────────────────────────────────
# Create an OAuth 2.0 Client ID at:
# https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=

# ── Email notifications ───────────────────────────────────────────────────────
# Console backend prints email locally. Use SMTP backend in production.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=DistillPage <notifications@distillpage.com>

# ── NOWPayments ────────────────────────────────────────────────────────────────
# Sign up at https://nowpayments.io and get your API key from the dashboard.
# Use the sandbox key (https://account-sandbox.nowpayments.io) for local dev.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# Set to false in production
NOWPAYMENTS_SANDBOX=true
# Public HTTPS URL where NOWPayments will POST payment updates.
# Use ngrok locally: ngrok http 8000  →  https://<id>.ngrok.io/api/payments/webhook/
NOWPAYMENTS_IPN_CALLBACK_URL=
# Where NOWPayments redirects the user after a successful payment
NOWPAYMENTS_SUCCESS_URL=http://localhost:5173?payment=success
# Where NOWPayments redirects the user after a cancelled payment
NOWPAYMENTS_CANCEL_URL=http://localhost:5173
# Web conversion AI Cleanup
OPENAI_API_KEY=
AI_CLEANUP_MODEL=gpt-4o-mini
CUSTOM_EXTRACTION_MODEL=gpt-4o-mini
# Wait for delayed cookie banners/popups before browser-based AI cleanup.
AI_CLEANUP_RENDER_WAIT_MS=5000
# OPENAI_BASE_URL=

# Frontend feature flags. Change monitoring is disabled in production by default.
# CHANGE_MONITORING_ENABLED=true
# VITE_ENABLE_CHANGE_MONITORING=true
