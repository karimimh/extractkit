# Copy this file to `.env`.
#
# Local development:
# - Use POSTGRES_HOST=localhost if PostgreSQL runs on your machine.
# - Use VITE_API_BASE_URL=http://127.0.0.1:8000 when running Vite separately.
#
# Non-Docker production from DEPLOY.md:
# - Use POSTGRES_HOST=localhost.
# - Keep VITE_API_BASE_URL empty when Nginx serves frontend and proxies /api.
#
# Docker production from DEPLOY.md:
# - Use POSTGRES_HOST=db.
# - Keep VITE_API_BASE_URL empty when the frontend container proxies /api.

# -- Django -------------------------------------------------------------------
SECRET_KEY=change-me-generate-a-long-random-value
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,extractkit.io,www.extractkit.io
CHANGE_MONITORING_ENABLED=false

# -- Database -----------------------------------------------------------------
POSTGRES_DB=extractkit
POSTGRES_USER=extractkit
POSTGRES_PASSWORD=change-me
# Docker: db
# Local/non-Docker production: localhost
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# -- Frontend build settings --------------------------------------------------
# Production, Docker, or same-origin Nginx proxy: leave empty.
# Separate local Vite dev server: http://127.0.0.1:8000
VITE_API_BASE_URL=
VITE_ENABLE_CHANGE_MONITORING=false
VITE_GOOGLE_CLIENT_ID=

# -- Google OAuth -------------------------------------------------------------
# Create an OAuth 2.0 Client ID at:
# https://console.cloud.google.com -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=

# -- Email notifications ------------------------------------------------------
# Console backend prints email locally. Use SMTP backend in production.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=ExtractKit <notifications@extractkit.io>

# -- NOWPayments --------------------------------------------------------------
# Sign up at https://nowpayments.io and get your API key from the dashboard.
# Use the sandbox key (https://account-sandbox.nowpayments.io) for local dev.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# Set to false in production.
NOWPAYMENTS_SANDBOX=true
# Public HTTPS URL where NOWPayments will POST payment updates.
# Local development can use ngrok:
# ngrok http 8000 -> https://<id>.ngrok.io/api/payments/webhook/
NOWPAYMENTS_IPN_CALLBACK_URL=
NOWPAYMENTS_SUCCESS_URL=http://localhost:5173?payment=success
NOWPAYMENTS_CANCEL_URL=http://localhost:5173?payment=cancelled

# -- Web conversion AI Cleanup ------------------------------------------------
OPENAI_API_KEY=
AI_CLEANUP_MODEL=gpt-4o-mini
CUSTOM_EXTRACTION_MODEL=gpt-4o-mini
# Wait for delayed cookie banners/popups before browser-based AI cleanup.
AI_CLEANUP_RENDER_WAIT_MS=5000
# OPENAI_BASE_URL=
