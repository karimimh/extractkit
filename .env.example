# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DB=web_to_pdf
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Google OAuth ───────────────────────────────────────────────────────────────
# Create an OAuth 2.0 Client ID at:
# https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=

# ── NOWPayments ────────────────────────────────────────────────────────────────
# Sign up at https://nowpayments.io and get your API key from the dashboard.
# Use the sandbox key (https://account-sandbox.nowpayments.io) for local dev.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# Set to false in production
NOWPAYMENTS_SANDBOX=true
# Public HTTPS URL where NOWPayments will POST payment updates.
# Use ngrok locally: ngrok http 8000  →  https://<id>.ngrok.io/api/payments/webhook/
NOWPAYMENTS_IPN_CALLBACK_URL=
# Where NOWPayments redirects the user after a successful payment
NOWPAYMENTS_SUCCESS_URL=http://localhost:5173?payment=success
# Where NOWPayments redirects the user after a cancelled payment
NOWPAYMENTS_CANCEL_URL=http://localhost:5173
